{
  "name": "@ticketing/layout-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "dev": "vite demo --host 127.0.0.1 --port 5174 --strictPort",
    "build:demo": "vite build demo --outDir ../dist/demo",
